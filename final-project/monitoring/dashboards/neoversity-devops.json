{
  "id": null,
  "uid": "neoversity-final-top",
  "title": "Neoversity \u2014 Final DevOps / TOP",
  "tags": [
    "neoversity",
    "final-project",
    "top"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Django ready replicas",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"neoversity\",deployment=\"django-app\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Django CPU cores",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"neoversity\",container=\"django\",image!=\"\"}[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Django memory bytes",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"neoversity\",container=\"django\",image!=\"\"})",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Django unavailable replicas",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_unavailable{namespace=\"neoversity\",deployment=\"django-app\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Django HPA desired replicas",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"neoversity\",horizontalpodautoscaler=\"django-app\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    }
  ]
}
